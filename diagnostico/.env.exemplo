# Copie para .env e preencha. O arquivo .env não vai para o Git.
PAGESPEED_API_KEY=
# Use 0 para não usar o Lighthouse local quando o PageSpeed falhar
USAR_LIGHTHOUSE_LOCAL=1
# Opcional: caminho de um Chromium já instalado
# CHROMIUM_PATH=
# Opcional: pasta dos relatórios (padrão: ./relatorios)
# PASTA_RELATORIOS=
# Opcional: assinatura da página final (padrão: Vania Araripe / Gestão de projetos digitais)
# ASSINATURA_NOME=
# ASSINATURA_CARGO=
