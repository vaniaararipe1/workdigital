{% extends "base_lead.html.j2" %}
{% block conteudo %}
      <p style="margin:0 0 16px">Olá{% if primeiro_nome %}, {{ primeiro_nome }}{% endif %}!</p>
      <p style="margin:0 0 22px">A análise técnica do site <b>{{ host }}</b> ficou pronta. O relatório completo, em PDF, está em anexo. Aqui vai o resumo:</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px">
        <tr>
{% for n in notas %}
          <td width="33%" align="center" valign="top" style="padding:{% if not loop.first %}0 0 0 6px{% else %}0{% endif %}">
            <div style="border:1px solid #E6E3EE;border-radius:12px;padding:16px 6px;background:#FAF9FD">
              <div style="font-family:Arial,Helvetica,sans-serif;font-size:32px;font-weight:bold;line-height:1;color:{{ n.cor }}">{{ n.valor }}</div>
              <div style="margin-top:8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.35;color:#5E5D6E">{{ n.nome }}{% if n.valor == "—" %}<br>não foi possível medir{% endif %}</div>
            </div>
          </td>
{% endfor %}
        </tr>
      </table>
      <p style="margin:0 0 8px;font-size:13px;color:#77768A">Notas de 0 a 100. O relatório mostra o que foi medido em cada uma e como a nota foi calculada.</p>
{% if principais %}
      <p style="margin:18px 0 8px"><b>Os pontos que mais pedem atenção:</b></p>
      <ul style="margin:0 0 18px;padding-left:20px">
{% for p in principais %}
        <li style="margin:0 0 10px"><b>{{ p.titulo }}.</b> {{ p.o_que_vimos }}{% if p.referencia %}<br><span style="color:#5E5D6E">Recomendado: {{ p.referencia.recomendado }} <span style="font-size:13px;color:#77768A">(fonte: {{ p.referencia.fonte }})</span>.</span>{% endif %}</li>
{% endfor %}
      </ul>
{% endif %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0 20px">
        <tr><td style="background:#F3EEFF;border-radius:12px;padding:20px 22px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#23232B">
          <b style="color:#16171B">Prazer, eu sou a {{ assinatura.nome }}, da Work Digital.</b> Cuido da gestão de projetos digitais e vou olhar o seu site pessoalmente.<br><br>
          A avaliação completa, revisada por mim, chega em até <b>{{ prazo_dias }} dias úteis</b>. Nela eu incluo a minha leitura sobre a clareza da proposta e a prova social do site, e um plano "Por onde começar", em ordem de impacto.
        </td></tr>
      </table>
      <p style="margin:0 0 14px">Quer adiantar a conversa?</p>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px">
        <tr><td style="background:#04CD8F;border-radius:8px">
          <a href="{{ whatsapp_url }}" style="display:inline-block;padding:14px 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#121316;text-decoration:none">Falar com a {{ assinatura.nome.split()[0] }} no WhatsApp</a>
        </td></tr>
      </table>
      <p style="margin:0 0 10px">Se preferir, é só responder este e-mail.</p>
{% endblock %}
