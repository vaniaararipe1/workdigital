{#- Assinatura de e-mail da Work Digital (mesmo desenho da assinatura do Gmail da Vania). -#}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:26px 0 0">
  <tr>
    <td valign="top" style="padding:0 36px 0 0;font-family:Arial,Helvetica,sans-serif">
      <div style="font-size:18px;line-height:1.3;color:#16171B">{{ assinatura.nome }}</div>
      <div style="font-size:14px;line-height:1.4;color:#6025E1;margin:4px 0 16px">{{ assinatura.funcao }}</div>
      <div style="font-size:13px;line-height:1.4;color:#16171B">{{ assinatura.telefone }}</div>
      <div style="font-size:13px;line-height:1.4;margin:10px 0 0"><a href="mailto:{{ assinatura.email }}" style="color:#6025E1;text-decoration:none">{{ assinatura.email }}</a></div>
      {% if assinatura.redes %}
      <div style="margin:14px 0 0">{% for r in assinatura.redes %}<a href="{{ r.url }}" style="text-decoration:none"><img src="cid:{{ r.nome }}" width="18" height="18" alt="{{ r.nome | capitalize }}" style="display:inline-block;width:18px;height:18px;border:0;margin:0 8px 0 0"></a>{% endfor %}</div>
      {% endif %}
    </td>
    <td valign="top" style="padding:8px 0 0">
      <img src="cid:logo_cor" width="150" alt="Work Digital" style="display:block;width:150px;height:auto;border:0;margin:0 0 14px">
      <a href="https://workdigital.art.br" style="display:block;background:#6025E1;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;padding:7px 10px;text-decoration:none">workdigital.art.br</a>
    </td>
  </tr>
</table>
