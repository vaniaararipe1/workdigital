{% extends "base_lead.html.j2" %}
{% block conteudo %}
      <p style="margin:0 0 16px">Olá{% if primeiro_nome %}, {{ primeiro_nome }}{% endif %}!</p>
      <p style="margin:0 0 16px">Como combinado, segue em anexo a avaliação completa do site <b>{{ host }}</b>, revisada por mim.</p>
      <p style="margin:0 0 8px">Nela você encontra:</p>
      <ul style="margin:0 0 20px;padding-left:20px">
        <li style="margin:0 0 6px">as notas de velocidade, experiência e SEO, com o que foi medido;</li>
        <li style="margin:0 0 6px">a minha leitura sobre a clareza da proposta e a prova social do site;</li>
        <li style="margin:0 0 6px">o plano "Por onde começar", em ordem de impacto.</li>
      </ul>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 20px">
        <tr><td style="background:#F3EEFF;border-radius:12px;padding:20px 22px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#23232B">
          <b style="color:#16171B">Vamos conversar 30 minutos?</b> Eu te mostro por onde começar e o que dá para resolver rápido. Sem compromisso.
        </td></tr>
      </table>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px">
        <tr><td style="background:#04CD8F;border-radius:8px">
          <a href="{{ whatsapp_url }}" style="display:inline-block;padding:14px 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#121316;text-decoration:none">Marcar a conversa pelo WhatsApp</a>
        </td></tr>
      </table>
      <p style="margin:0 0 10px">Se preferir, é só responder este e-mail.</p>
{% endblock %}
